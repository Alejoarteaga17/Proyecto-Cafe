# Infrastructure service environment variables
# These are consumed by the infrastructure Docker container and used to configure AWS resources

# Developer identifier for unique resource naming in shared AWS accounts
# Used to avoid collisions when multiple developers deploy simultaneously
# Example: "juan-pablo" or your short GitHub username
DEVELOPER=your-developer-name

# Stage for deployment (dev, test, or prod)
# Controls resource naming, Lambda layer paths, and CloudWatch alarms
# Typical values: dev (for development), test (for testing), prod (for production)
STAGE=dev

# MongoDB Atlas connection credentials
# These will be stored in AWS Secrets Manager for secure access by Lambda functions

# MongoDB Atlas cluster hostname
# Format: cluster0.xxxxx.mongodb.net
MONGO_HOST=cluster0.xxxxx.mongodb.net

# MongoDB Atlas username (separate from AWS account)
# Created in MongoDB Atlas Console → Database Access
MONGO_USERNAME=coffee_user

# MongoDB Atlas password
# Generated in MongoDB Atlas Console → Database Access
MONGO_PASSWORD=your-secure-password-here

# MongoDB database name in your Atlas cluster
# This database will store both batch historical data and streaming sensor readings
MONGO_DBNAME=coffee_cultivation

# Email address for critical operational alerts
# Used by SNS topic in infrastructure/serverless/alerts
# Should be a team distribution list or operations channel
ALERTS_EMAIL=team-alerts@example.com
