# AWS CLI environment variables
# Required for all AWS operations (deployment, configuration, diagnostics)

# AWS Access Key ID for your IAM user
# Get from: AWS Console → IAM → Your User → Security Credentials → Access Keys
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE

# AWS Secret Access Key
# Get from: AWS Console → IAM → Your User → Security Credentials → Access Keys
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# AWS region for all infrastructure deployments
# Must be: us-east-1 (enforced by project constraints)
AWS_DEFAULT_REGION=us-east-1

# Output format for AWS CLI commands
# Recommended: json (for programmatic parsing)
AWS_DEFAULT_OUTPUT=json
