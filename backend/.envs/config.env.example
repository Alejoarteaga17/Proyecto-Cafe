# Backend service environment variables
# These are consumed by the backend Docker container and exported to Lambda environments

# Developer identifier for unique resource naming in shared AWS accounts
# Used to avoid collisions when multiple developers deploy simultaneously
# Example: "juan-pablo" or your short GitHub username
DEVELOPER=your-developer-name

# Stage for deployment (dev, test, or prod)
# Controls resource naming, Lambda layer paths, and CloudWatch alarms
# Typical values: dev (for development), test (for testing), prod (for production)
STAGE=dev
